{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/log", "destination": "https://log.kirka.day", "statusCode": 301 },
    { "source": "/log/:path*", "destination": "https://log.kirka.day/:path*", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
